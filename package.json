{
  "name": "church-projector",
  "version": "1.0.0",
  "description": "App de proyección para iglesia — letras, versículos, media y audio",
  "type": "module",
  "main": "out/main/index.js",
  "author": "ArielFerger",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "convert-bibles": "tsx scripts/convert-bible.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "package": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "make:win": "npm run dist:win",
    "make:linux": "npm run dist:linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.0",
    "electron-store": "^10.0.0",
    "framer-motion": "^12.12.1",
    "howler": "^2.2.4",
    "i18next": "^25.2.1",
    "lucide-react": "^0.511.0",
    "music-metadata": "^10.2.0",
    "react-i18next": "^15.5.1",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/forms": "^0.5.10",
    "@types/howler": "^2.2.12",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
