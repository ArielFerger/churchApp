{
  "name": "church-projector",
  "version": "1.3.0",
  "description": "App de proyección para iglesia — letras, versículos, media y audio",
  "type": "module",
  "main": "out/main/index.js",
  "author": {
    "name": "ArielFerger",
    "email": "arielferger@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "convert-bibles": "tsx scripts/convert-bible.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "herramientas:instalar": "node scripts/herramientas/py.mjs instalar_herramientas.py",
    "herramientas:estado": "node scripts/herramientas/py.mjs instalar_herramientas.py --estado",
    "herramientas:actualizar": "node scripts/herramientas/py.mjs instalar_herramientas.py --actualizar",
    "descargar": "node scripts/herramientas/py.mjs descargar_youtube.py",
    "package": "electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "make:win": "npm run dist:win",
    "make:linux": "npm run dist:linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.0",
    "electron-store": "^10.0.0",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.12.1",
    "howler": "^2.2.4",
    "i18next": "^25.2.1",
    "lucide-react": "^0.511.0",
    "music-metadata": "^10.2.0",
    "react-i18next": "^15.5.1",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.12",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^20.11.2",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
